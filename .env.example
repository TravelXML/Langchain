# Copy this file to .env and adjust values for your local environment.
# Never commit the real .env file.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database ---
# Development default: local SQLite file under ./data
DATABASE_URL=sqlite+aiosqlite:///./data/job_automation.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/job_automation

# --- Local LLM (Ollama) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120

# --- Optional OpenAI-compatible fallback (disabled by default) ---
FALLBACK_LLM_ENABLED=false
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# --- Automation safety defaults ---
AUTOMATION_DRY_RUN=true
APPROVAL_MODE=manual

# --- Config file locations (override only if you relocate them) ---
CONFIG_DIR=./config
UPLOAD_DIR=./data/uploads

# --- LangGraph run persistence (separate from DATABASE_URL) ---
LANGGRAPH_CHECKPOINT_PATH=./data/langgraph_checkpoints.db
